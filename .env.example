# ---- Database (PostgreSQL / Supabase) ----
# Supabase: Project Settings -> Database -> Connection string (URI).
# Example:
# DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/collegeconnect

# Fallback individual settings (used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=collegeconnect

# ---- Security ----
# Use a long random string. Generate one:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- App ----
# Public base URL. The permanent college QR code points to APP_URL/events.
# Update this after deployment; the QR code regenerates automatically.
APP_URL=http://localhost:3000

# ---- Uploads ----
MAX_FILE_SIZE_MB=5
